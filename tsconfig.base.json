{
  "compilerOptions": {
    "target": "ES2024",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "composite": true,
    "emitDeclarationOnly": true
  }
}
