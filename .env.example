# SiteLens environment variables (Tech §14).
# Copy the web variables to apps/web/.env.local and the worker variables to
# apps/worker/.env. Variables used by both apps go in both files.
# Never commit real values: both local files are gitignored.

# web: Supabase project URL for the Supabase client
NEXT_PUBLIC_SUPABASE_URL=
# web: Supabase publishable (anon) key for the Supabase client
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# web (server only), worker: Supabase service role key. Never sent to the browser
SUPABASE_SECRET_KEY=
# worker: Postgres session pooler connection string for pg-boss and transactions
DATABASE_URL=
# web: HMAC secret for email and IP hashes and signed URLs. Never rotated
HASH_SECRET=
# worker: Google API key for PageSpeed Insights and CrUX, restricted to those two APIs
GOOGLE_API_KEY=
# worker: Claude API key
ANTHROPIC_API_KEY=
# web, worker: public app URL for links, the print route and the crawler info URL in the user agent
NEXT_PUBLIC_APP_URL=
# worker: local worker concurrency; overrides settings
WORKER_CONCURRENCY=
# web: Phases 1-2 comma-separated sign-in allowlist. Empty or not set means nobody can sign in
ALLOWED_EMAILS=
# worker (tests only): SSRF guard test allowlist. Ignored unless NODE_ENV=test
SSRF_TEST_ALLOWLIST=

# --- Phase 3 (not used yet) ---
# web, worker: Sentry error reporting
# SENTRY_DSN=
# web: Cloudflare Turnstile bot check
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# web: Stripe payments
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# web, worker: Resend email
# RESEND_API_KEY=
